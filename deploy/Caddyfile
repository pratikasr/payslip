# Payslip origin front (deploy/compose.yml). Plain HTTP on four ports: CloudFront terminates TLS.
#
# Every request must carry the X-Payslip-Origin header with the secret that deploy/aws/provision.sh
# set as a custom origin header on this stack's two CloudFront distributions. A request that
# arrives any other way (another AWS customer's distribution pointed at this instance, which the
# security group's CloudFront rule would admit) gets 403 and never reaches a service or a web app.
# ORIGIN_SECRET comes from payslip.env through compose.yml, substituted when Caddy parses this file.
{
	auto_https off
	admin off
}

(gate) {
	@direct not header X-Payslip-Origin {$ORIGIN_SECRET}
	respond @direct "This origin only answers its own CloudFront distributions." 403
}

# Public statements page and service (books distribution).
:3001 {
	import gate
	reverse_proxy books-web:3000
}

:8081 {
	import gate
	# Payment requests need the company's service (it knows the contractors); statements stay public.
	@requests path /api/portal/*
	reverse_proxy @requests app-service:8080
	reverse_proxy books-service:8080
}

# Company console and full-mode service (app distribution, behind CloudFront's basic auth).
:3002 {
	import gate
	reverse_proxy app-web:3000
}

# The distribution sends /api/* here. Two of those paths belong to the web app, not the service:
# /api/auth/* (sign-in, Better Auth) and /api/svc/* (the same-origin proxy that attaches the
# signed-in member's token; ADR-026). The matched directive keeps its place and the one without a
# matcher is sorted last (caddyserver.com/docs/caddyfile/directives, "Sorting algorithm", checked
# 11 Oct 2026). With sign-in off nothing calls either path; the web app answers 404 on the first.
:8082 {
	import gate
	@web path /api/auth/* /api/svc/*
	reverse_proxy @web app-web:3000
	reverse_proxy app-service:8080
}
