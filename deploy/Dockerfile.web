# syntax=docker/dockerfile:1
# Payslip web image (Next.js 15, standalone output). Build context: the repository root
# (deploy/compose.yml sets it); deploy/Dockerfile.web.dockerignore keeps node_modules, .next and
# .env files out of the context.
#
# NEXT_PUBLIC_* values are inlined at build time, so each deployment (books, app) is its own
# build with its own arguments; so is PAYSLIP_AUTH, which the prerendered pages read. Server-only
# settings (PAYSLIP_API_INTERNAL_URL, PORT, HOSTNAME, the rest of the sign-in block) are read
# when the container starts.
FROM node:22-bookworm-slim AS builder
ENV NEXT_TELEMETRY_DISABLED=1
# The exact pnpm the project pins (web/package.json "packageManager").
RUN npm install -g pnpm@11.3.0
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir /root/.local/share/pnpm/store
COPY web/ ./
# "/" means the page's own origin: the proxy in front sends /api/* to the service (web/src/lib/api.ts).
ARG NEXT_PUBLIC_PAYSLIP_API_URL=/
ARG NEXT_PUBLIC_PAYSLIP_PORTAL_URL=
ARG NEXT_PUBLIC_PAYSLIP_CONSOLE_URL=
ARG NEXT_PUBLIC_PAYSLIP_DEMO=
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ENV NEXT_PUBLIC_PAYSLIP_API_URL=${NEXT_PUBLIC_PAYSLIP_API_URL} \
    NEXT_PUBLIC_PAYSLIP_PORTAL_URL=${NEXT_PUBLIC_PAYSLIP_PORTAL_URL} \
    NEXT_PUBLIC_PAYSLIP_CONSOLE_URL=${NEXT_PUBLIC_PAYSLIP_CONSOLE_URL} \
    NEXT_PUBLIC_PAYSLIP_DEMO=${NEXT_PUBLIC_PAYSLIP_DEMO} \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=${NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID}
# Sign-in (ADR-026): "required" or empty. The root layout and the sign-in page read it while the
# static pages are prerendered (web/src/lib/auth-config.ts), so the image is built for one
# setting; compose.yml passes the same value at run time. Secrets are never build arguments.
ARG PAYSLIP_AUTH=
ENV PAYSLIP_AUTH=${PAYSLIP_AUTH}
# `pnpm build` first copies the ZXing WebAssembly reader into public/zxing (web/scripts).
# Next needs more heap than Node gives itself on a 2 GB host; the host has swap for the rest.
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
# The standalone server plus the two folders it does not copy by itself (Next docs: output).
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
# Where auth.db lives when sign-in is on (compose.yml mounts the app-auth volume here). Owned by
# the runtime user because a fresh named volume takes the owner and mode of the image's mount
# point (moby daemon/container/container_unix.go copyExistingContents, which is continuity
# fs.CopyDir; checked 11 Oct 2026), so uid 1000 can write to it. Unused with sign-in off.
RUN mkdir -p /var/lib/payslip-auth && chown 1000:1000 /var/lib/payslip-auth
# The image's unprivileged user (uid 1000, "node").
USER 1000:1000
EXPOSE 3000
CMD ["node", "server.js"]
