# Project env file for deploy/compose.yml. Copy to deploy/payslip.env on the instance and pass it
# with --env-file to every compose command. Never commit payslip.env (it is git-ignored).
# A value with $ or # or spaces goes in single quotes, for example PAYSLIP_SEED_PASSPHRASE='words with $ and # in them'.

# Zcash network for both services: testnet or mainnet. One network per host; the data volumes are per network.
ZCASH_NETWORK=
# lightwalletd gRPC URL; empty uses https://testnet.zec.rocks:443 or https://zec.rocks:443.
LIGHTWALLETD_URL=

# Host name of the books CloudFront distribution without a scheme, BOOKS_HOST in deploy/aws/outputs.env (for example d1a2b3c4d5e6f7.cloudfront.net).
BOOKS_HOST=
# Host name of the app CloudFront distribution without a scheme, APP_HOST in deploy/aws/outputs.env.
APP_HOST=
# Public DNS name of the instance, INSTANCE_DNS in deploy/aws/outputs.env: the Host header CloudFront sends when it does not forward the viewer's.
INSTANCE_DNS=
# Extra Host header values both services answer for, comma-separated; empty is fine. Use it to keep the *.cloudfront.net names working after a real domain is attached (deploy/README.md).
EXTRA_ALLOWED_HOSTS=
# Secret that CloudFront adds to every origin request as X-Payslip-Origin, ORIGIN_SECRET in deploy/aws/outputs.env; Caddy refuses requests without it.
ORIGIN_SECRET=

# Passphrase that encrypts the company service's seed (12+ characters). Keep a copy in a password manager; without it the seed file is unreadable.
PAYSLIP_SEED_PASSPHRASE=
# Company service: wallet birthday height at init; empty uses the chain tip minus 10. Only read by `run --rm app-service init`.
PAYSLIP_BIRTHDAY_HEIGHT=
# Where the books service starts scanning keys it does not know; empty uses Ironwood activation. Set it just below the demo wallet's birthday to keep first scans short (testnet kit: 4466850).
PAYSLIP_VIEWER_BIRTHDAY_HEIGHT=

# Swap venue of the company service: near-intents (mainnet default), maya, or testnet (testnet default, fixed rate; refused on mainnet).
PAYSLIP_SWAP_VENUE=
# Testnet venue rate in USD per TAZ; empty uses 1350000.00.
PAYSLIP_TESTNET_RATE_USD=
# Confirmations before a note is spent; empty uses 3.
PAYSLIP_MIN_CONFIRMATIONS=
# Optional 1Click partner JWT (lowers fees); empty works without one.
NEAR_INTENTS_JWT=
# Payslip's fee on the USDC to ZEC funding swap in basis points, 0 to 300; empty means no fee.
PAYSLIP_APP_FEE_BPS=
# NEAR account that receives that fee; required when PAYSLIP_APP_FEE_BPS is above 0.
PAYSLIP_APP_FEE_RECIPIENT=
# Optional CoinGecko demo API key for higher rate limits, used by both services; empty works without one.
PAYSLIP_PRICE_API_KEY=

# App web build: set to 1 to show the "Viewing as" role switcher on mainnet (for a recorded demo); empty hides it. Testnet always shows it.
NEXT_PUBLIC_PAYSLIP_DEMO=
# App web build: WalletConnect Cloud project id for mobile wallets on the Fund step; empty offers browser extension wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Parallel rustc jobs for the service image build; empty uses 1, which fits 2 GB of RAM plus swap. Raise it on a bigger instance.
CARGO_BUILD_JOBS=

# Sign-in (optional, deploy/README.md "Turn on sign-in"). Empty leaves the console as it is: no login of its own, CloudFront's basic auth in front.
# off (default) or required: Google sign-in with roles in front of the console and every payer route. The app-web image build reads it too, so run `build app-web` after changing it.
PAYSLIP_AUTH=
# Google OAuth client id (type Web application) whose authorized redirect URI is https://<APP_HOST>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Google OAuth client secret of the same client. Never commit it.
GOOGLE_CLIENT_SECRET=
# Secret that signs session cookies and encrypts the token signing keys in auth.db: openssl rand -base64 32. Never commit it; keep a copy in a password manager.
BETTER_AUTH_SECRET=
# The Google account whose first sign-in creates the organisation and becomes its admin; after that membership is invite-only.
PAYSLIP_BOOTSTRAP_ADMIN_EMAIL=
# Google Workspace domain sign-in is locked to (company.com, or * for any Workspace domain); empty allows any Google account.
PAYSLIP_GOOGLE_WORKSPACE_DOMAIN=
# Approvals (by admins or approvers, one each) a run needs before it is paid, 0 to 10; empty uses 1 with PAYSLIP_AUTH=required. At 2 or more the run's creator cannot be one of them.
PAYSLIP_APPROVALS_REQUIRED=
# Derived by compose.yml, no entry needed: BETTER_AUTH_URL and the token issuer are https://$APP_HOST, the service reads the signing keys at http://app-web:3000/api/auth/jwks, the audience is payslip-service, auth.db is on the payslip_app-auth volume.

# backup.sh: S3 bucket that receives the encrypted archives, BACKUP_BUCKET in deploy/aws/outputs.env.
BACKUP_BUCKET=
# backup.sh: age public key (age1...) the archives are encrypted to. Make it on your own machine with `age-keygen -o payslip-backup.key`; the private key never goes on the server.
BACKUP_AGE_RECIPIENT=
# backup.sh: region of the bucket, AWS_REGION in deploy/aws/outputs.env; empty uses us-east-1.
AWS_REGION=
