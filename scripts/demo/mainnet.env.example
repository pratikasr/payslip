# Copy to scripts/demo/mainnet.env (ignored by git) and fill in. One line per variable.
# Network: must be mainnet for the recorded demo.
ZCASH_NETWORK=mainnet
# Primary mainnet lightwalletd (ADR-019); fallback https://zec-node.cakewallet.com:443.
LIGHTWALLETD_URL=https://zec.rocks:443
# Separate data directory for mainnet; never share it with testnet.
PAYSLIP_DATA_DIR=./data/mainnet
PAYSLIP_BIND=127.0.0.1:8080
# Three confirmations before spending on mainnet (75-second blocks).
PAYSLIP_MIN_CONFIRMATIONS=3
PAYSLIP_SWAP_VENUE=near-intents
# JSON file with the six contractors, their unified addresses, USD amounts and invoice refs.
DEMO_CONTRACTORS_FILE=scripts/demo/contractors.mainnet.json
# USDC origin chain for the 1Click deposit: base, arb or eth.
DEMO_ORIGIN_CHAIN=base
# The payer's EVM address on that chain; 1Click refunds here if the swap cannot complete.
DEMO_REFUND_ADDRESS=
