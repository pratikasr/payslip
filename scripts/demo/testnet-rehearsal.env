# Testnet rehearsal of scripts/mainnet-demo.sh. The passphrase comes from service/.env unless set here.
# The rehearsal runs its own service on its own port and data directory, so it never writes to
# another Payslip wallet on this machine (a demo service on 127.0.0.1:8080, for example).
ZCASH_NETWORK=testnet
LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# Its own wallet. The first run creates a new seed here, prints its treasury address and stops
# at funding with treasury_insufficient; send faucet coins to that address and run it again.
PAYSLIP_DATA_DIR=./data/testnet-rehearsal
PAYSLIP_BIND=127.0.0.1:8180
PAYSLIP_MIN_CONFIRMATIONS=1
# Empty: on testnet the six dev contractor wallets are used and amounts come from the example file.
DEMO_CONTRACTORS_FILE=
