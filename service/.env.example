# Zcash network: testnet for development, mainnet for the demo run.
ZCASH_NETWORK=
# lightwalletd gRPC URL; empty uses https://testnet.zec.rocks:443 or https://zec.rocks:443.
LIGHTWALLETD_URL=
# Where wallet.db, payslip.db, the encrypted seed and viewer databases live; empty uses ./data/<network>.
PAYSLIP_DATA_DIR=
# Passphrase that encrypts the payer seed file (12+ characters). Never commit it.
PAYSLIP_SEED_PASSPHRASE=
# HTTP bind address; empty uses 127.0.0.1:8080.
PAYSLIP_BIND=
# Web app origins allowed by CORS, comma-separated; empty uses http://localhost:3000,http://127.0.0.1:3000.
PAYSLIP_WEB_ORIGIN=
# Swap venue: near-intents (mainnet default), maya, or testnet (testnet default, fixed rate).
PAYSLIP_SWAP_VENUE=
# Testnet venue rate in USD per TAZ; empty uses 1350000.00.
PAYSLIP_TESTNET_RATE_USD=
# Confirmations before a note is spent; empty uses 3.
PAYSLIP_MIN_CONFIRMATIONS=
# Optional wallet birthday height for a new wallet; empty uses the chain tip minus 10.
PAYSLIP_BIRTHDAY_HEIGHT=
# NEAR Intents 1Click API base URL; empty uses https://1click.chaindefuser.com.
NEAR_INTENTS_API_URL=
# Optional 1Click partner JWT (lowers fees); empty works without one.
NEAR_INTENTS_JWT=
# Maya node URL for the fallback venue; empty uses https://mayanode.mayachain.info.
MAYA_API_URL=
# Maya Midgard URL for the fallback venue's indicative price; empty uses https://midgard.mayachain.info.
MAYA_MIDGARD_URL=
# full (default) or statements: statements runs with no wallet, serving statements and payment proofs only.
PAYSLIP_MODE=
# Where view-only scans start for keys this service does not know; empty uses Ironwood activation.
PAYSLIP_VIEWER_BIRTHDAY_HEIGHT=
# ZEC market price API (CoinGecko v3 base URL) for value at receipt; empty uses the public API, off disables.
PAYSLIP_PRICE_API_URL=
# Optional CoinGecko demo API key for higher rate limits; empty works without one.
PAYSLIP_PRICE_API_KEY=
# Payslip's fee on the USDC to ZEC funding swap in basis points, 0 to 300; empty means no fee.
PAYSLIP_APP_FEE_BPS=
# NEAR account that receives that fee; required when PAYSLIP_APP_FEE_BPS is above 0.
PAYSLIP_APP_FEE_RECIPIENT=
# Extra Host header values the API answers for, comma-separated (a public host name behind a proxy, or a container name with its port); the bind address, localhost and 127.0.0.1 on the bind port are always allowed.
PAYSLIP_ALLOWED_HOSTS=
# Set to 1 to let full mode listen on a non-loopback address (a container that a proxy reaches); only behind your own gate, see deploy/README.md. Empty keeps full mode on loopback.
PAYSLIP_ALLOW_REMOTE_PAYER=
