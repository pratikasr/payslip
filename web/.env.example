# Base URL of the Payslip service API; empty uses http://127.0.0.1:8080. A single / means the page's own origin, for a deployment where a proxy sends /api/* to the service (deploy/).
NEXT_PUBLIC_PAYSLIP_API_URL=
# Server-side reads only, never sent to the browser: where the Next server reaches the service when NEXT_PUBLIC_PAYSLIP_API_URL is / (for example http://books-service:8080 in deploy/compose.yml); empty uses NEXT_PUBLIC_PAYSLIP_API_URL.
PAYSLIP_API_INTERNAL_URL=
# WalletConnect Cloud project id; leave empty to offer only browser extension wallets on the Fund step.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public address contractors can open (for example a statements-only deployment); invite and proof links use it, empty uses the page's own origin.
NEXT_PUBLIC_PAYSLIP_PORTAL_URL=
# Set to 1 to show the "Viewing as" role switcher on mainnet (for a recorded demo); testnet always shows it, empty hides it on mainnet.
NEXT_PUBLIC_PAYSLIP_DEMO=
# The company name shown on the console, payslips, Books and payment proofs; empty shows "Payslip Labs".
NEXT_PUBLIC_PAYSLIP_COMPANY_NAME=
